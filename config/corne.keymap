#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // Home-row mod, equivalent to MT() with TAPPING_TERM 150 + PERMISSIVE_HOLD
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
        };

        // MT(MOD_LSFT, KC_C) used TAPPING_TERM - 5
        hm_c: homerow_mod_c {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <145>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
        };

        // Layer-tap, TAPPING_TERM 150
        lt_std: layer_tap_std {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };

        // LT(3, KC_T) used TAPPING_TERM + 10
        lt_t: layer_tap_t {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&caps_word  &kp Q          &kp W          &kp F          &lt_std 2 P    &kp B            &kp J  &kp L          &kp U            &kp Y           &kp SEMI         &kp BSLH
&kp BSPC    &kp A          &kp R          &kp S          &lt_t 3 T      &kp G            &kp M  &kp N          &kp E            &kp I           &kp O            &kp SQT
&kp LGUI    &hm LGUI Z     &hm LALT X     &hm_c LSHFT C  &hm LCTRL D    &kp V            &kp K  &hm RCTRL H    &hm RSHFT COMMA  &hm RALT DOT    &hm RGUI FSLH    &kp RET
                                          &none          &kp SPACE      &kp ESC          &kp TAB  &sl 1        &none
            >;
        };

        symbol_layer {
            bindings = <
&to 0       &kp EXCL       &kp AT         &kp HASH       &kp DLLR       &kp PRCNT        &kp CARET  &kp AMPS    &kp STAR         &kp SQT         &kp FSLH         &kp F12
&trans      &kp ESC        &none          &kp MINUS      &kp COLON      &kp GRAVE        &kp EQUAL  &kp BSLH    &kp LBRC         &kp RBRC        &kp RET          &kp BSPC
&trans      &kp TILDE      &kp PIPE       &kp UNDER      &kp SEMI       &kp EXCL         &none      &kp LBKT    &kp LPAR         &kp RPAR        &kp RBKT         &none
                                          &trans         &trans         &trans           &trans     &to 0       &trans
            >;
        };

        media_num_layer {
            bindings = <
&trans      &none          &kp C_VOL_DN   &kp C_VOL_UP   &trans         &none            &kp PLUS   &kp N7      &kp N8           &kp N9          &none            &none
&trans      &kp ESC        &kp C_NEXT     &kp C_STOP     &kp C_PP       &none            &kp EQUAL  &kp N4      &kp N5           &kp N6          &kp RET          &none
&trans      &trans         &trans         &none          &none          &none            &kp N0     &kp N1      &kp N2           &kp N3          &kp DOT          &none
                                          &trans         &trans         &trans           &trans     &trans      &trans
            >;
        };

        nav_mouse_layer {
            bindings = <
&trans      &none          &none          &none          &trans         &none            &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB2
&trans      &kp ESC        &none          &none          &trans         &none            &none      &kp LEFT    &kp DOWN         &kp UP          &kp RIGHT        &kp RET
&trans      &kp LGUI       &kp LALT       &kp LSHFT      &kp LCTRL      &none            &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                                          &trans         &trans         &trans           &mkp MB1   &to 0       &trans
            >;
        };
    };
};
