#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// Corne 42-key positions:
//  0-11 top row (L 0-5, R 6-11)    12-23 home row (L 12-17, R 18-23)
// 24-35 bottom row (L 24-29, R 30-35)   36-41 thumbs (L 36-38, R 39-41)

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        // Left-hand mod-tap: only holds if a right-hand key is pressed
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            require-prior-idle-ms = <80>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Right-hand mod-tap: only holds if a left-hand key is pressed
        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            require-prior-idle-ms = <80>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Layer-tap for P and T (replaces lt_std / lt_t)
        lth: layer_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&caps_word  &kp Q          &kp W          &kp F          &lth 2 P       &kp B            &kp J  &kp L          &kp U            &kp Y           &kp SEMI         &kp BSLH
&kp BSPC    &kp A          &kp R          &kp S          &lth 3 T       &kp G            &kp M  &kp N          &kp E            &kp I           &kp O            &kp SQT
&kp LGUI    &hml LGUI Z    &hml LALT X    &hml LSHFT C   &hml LCTRL D   &kp V            &kp K  &hmr RCTRL H    &hmr RSHFT COMMA &hmr RALT DOT   &hmr RGUI FSLH   &kp RET
                                          &none          &kp SPACE      &kp ESC          &kp TAB  &sl 1        &none
            >;
        };

        symbol_layer {
            bindings = <
&to 0       &kp EXCL       &kp AT         &kp HASH       &kp DLLR       &kp PRCNT        &kp CARET  &kp AMPS    &kp STAR         &kp SQT         &kp FSLH         &kp F12
&trans      &kp ESC        &none          &kp MINUS      &kp COLON      &kp GRAVE        &kp EQUAL  &kp BSLH    &kp LBRC         &kp RBRC        &kp RET          &kp BSPC
&trans      &kp TILDE      &kp PIPE       &kp UNDER      &kp SEMI       &kp EXCL         &none      &kp LBKT    &kp LPAR         &kp RPAR        &kp RBKT         &none
                                          &trans         &trans         &trans           &trans     &to 0       &trans
            >;
        };

        media_num_layer {
            bindings = <
&trans      &none          &kp C_VOL_DN   &kp C_VOL_UP   &trans         &none            &kp PLUS   &kp N7      &kp N8           &kp N9          &none            &none
&trans      &kp ESC        &kp C_NEXT     &kp C_STOP     &kp C_PP       &none            &kp EQUAL  &kp N4      &kp N5           &kp N6          &kp RET          &none
&trans      &trans         &trans         &none          &none          &none            &kp N0     &kp N1      &kp N2           &kp N3          &kp DOT          &none
                                          &trans         &trans         &trans           &trans     &trans      &trans
            >;
        };

        nav_mouse_layer {
            bindings = <
&trans      &none          &none          &none          &trans         &none            &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB2
&trans      &kp ESC        &none          &none          &trans         &none            &none      &kp LEFT    &kp DOWN         &kp UP          &kp RIGHT        &kp RET
&trans      &kp LGUI       &kp LALT       &kp LSHFT      &kp LCTRL      &none            &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                                          &trans         &trans         &trans           &mkp MB1   &to 0       &trans
            >;
        };
    };
};
